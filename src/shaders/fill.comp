#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform PushConstants {
    float time;     // animation time in seconds
    uint width;
    uint height;
    uint triangleCount;

    // Camera data
    vec3 cameraPos;
    float padding2;
    vec3 cameraTarget;
    float padding3;
    vec3 cameraUp;
    float padding4;
} pc;

layout(std430, binding = 0) buffer Output {
    uint pixels[];
};

// Triangle data structure (matches GPUTriangle in C++)
struct Triangle {
    vec3 v0, v1, v2;        // Vertices
    vec3 normal;            // Face normal
    vec3 materialColor;     // Material color
    vec4 materialProps;     // reflectivity, roughness, transparency, refractionIndex
};

layout(std430, binding = 1) buffer TriangleBuffer {
    Triangle triangles[];
};

// Rotation matrices
vec3 rotateY(vec3 p, float a) {
    float ca = cos(a);
    float sa = sin(a);
    return vec3(ca * p.x + sa * p.z, p.y, -sa * p.x + ca * p.z);
}

vec3 rotateX(vec3 p, float a) {
    float ca = cos(a);
    float sa = sin(a);
    return vec3(p.x, ca * p.y - sa * p.z, sa * p.y + ca * p.z);
}

vec3 rotateZ(vec3 p, float a) {
    float ca = cos(a);
    float sa = sin(a);
    return vec3(ca * p.x - sa * p.y, sa * p.x + ca * p.y, p.z);
}

// Material structure
struct Material {
    vec3 color;
    float reflectivity;
    float roughness;
    float transparency;
    float refractionIndex;
};

// Ray structure
struct Ray {
    vec3 origin;
    vec3 direction;
};

// Hit information
struct HitInfo {
    bool hit;
    float t;
    vec3 point;
    vec3 normal;
    Material material;
};

// Triangle intersection using Möller–Trumbore algorithm
HitInfo intersectTriangle(Ray ray, Triangle tri) {
    HitInfo hit;
    hit.hit = false;

    const float EPSILON = 0.0000001;

    vec3 edge1 = tri.v1 - tri.v0;
    vec3 edge2 = tri.v2 - tri.v0;
    vec3 h = cross(ray.direction, edge2);
    float a = dot(edge1, h);

    if (a > -EPSILON && a < EPSILON) return hit; // Ray is parallel to triangle

    float f = 1.0 / a;
    vec3 s = ray.origin - tri.v0;
    float u = f * dot(s, h);

    if (u < 0.0 || u > 1.0) return hit;

    vec3 q = cross(s, edge1);
    float v = f * dot(ray.direction, q);

    if (v < 0.0 || u + v > 1.0) return hit;

    float t = f * dot(edge2, q);

    if (t > EPSILON) {
        hit.hit = true;
        hit.t = t;
        hit.point = ray.origin + t * ray.direction;
        hit.normal = normalize(tri.normal);

        // Create material from triangle data
        hit.material.color = tri.materialColor;
        hit.material.reflectivity = tri.materialProps.x;
        hit.material.roughness = tri.materialProps.y;
        hit.material.transparency = tri.materialProps.z;
        hit.material.refractionIndex = tri.materialProps.w;
    }

    return hit;
}

// Plane intersection
HitInfo intersectPlane(Ray ray, vec3 point, vec3 normal, Material mat) {
    HitInfo hit;
    hit.hit = false;

    float denom = dot(normal, ray.direction);
    if (abs(denom) < 0.001) return hit;

    float t = dot(point - ray.origin, normal) / denom;
    if (t < 0.001) return hit;

    hit.hit = true;
    hit.t = t;
    hit.point = ray.origin + t * ray.direction;
    hit.normal = normal;
    hit.material = mat;

    return hit;
}

// Scene intersection
HitInfo intersectScene(Ray ray) {
    HitInfo closestHit;
    closestHit.hit = false;
    closestHit.t = 1e30;

    // Intersect with all triangles from the scene
    for (uint i = 0; i < pc.triangleCount; i++) {
        HitInfo hit = intersectTriangle(ray, triangles[i]);
        if (hit.hit && hit.t < closestHit.t) {
            closestHit = hit;
        }
    }

    // Add a ground plane for reference
    Material groundMat;
    groundMat.color = vec3(0.8, 0.8, 0.8);
    groundMat.reflectivity = 0.1;
    groundMat.roughness = 0.9;
    groundMat.transparency = 0.0;
    groundMat.refractionIndex = 1.0;

    HitInfo groundHit = intersectPlane(ray, vec3(0, -2.0, 0), vec3(0, 1, 0), groundMat);
    if (groundHit.hit && groundHit.t < closestHit.t) {
        closestHit = groundHit;
    }

    return closestHit;
}

// Simple lighting calculation
vec3 calculateLighting(HitInfo hit, vec3 viewDir) {
    vec3 lightPos = vec3(sin(pc.time * 0.5) * 3.0, 3.0, cos(pc.time * 0.5) * 3.0);
    vec3 lightDir = normalize(lightPos - hit.point);
    vec3 lightColor = vec3(1.0, 0.95, 0.8);

    // Ambient
    vec3 ambient = hit.material.color * 0.1;

    // Diffuse
    float diff = max(dot(hit.normal, lightDir), 0.0);
    vec3 diffuse = diff * hit.material.color * lightColor * (1.0 - hit.material.roughness);

    // Specular (Blinn-Phong)
    vec3 halfDir = normalize(lightDir + viewDir);
    float spec = pow(max(dot(hit.normal, halfDir), 0.0), 32.0 * (1.0 - hit.material.roughness));
    vec3 specular = spec * lightColor * hit.material.reflectivity;

    return ambient + diffuse + specular;
}

// Fresnel reflectance (Schlick's approximation)
float fresnel(vec3 viewDir, vec3 normal, float n1, float n2) {
    float r0 = (n1 - n2) / (n1 + n2);
    r0 = r0 * r0;
    float cosTheta = max(dot(viewDir, normal), 0.0);
    return r0 + (1.0 - r0) * pow(1.0 - cosTheta, 5.0);
}

// Sky color with animated sun
vec3 getSkyColor(vec3 direction) {
    float t = 0.5 * (direction.y + 1.0);
    vec3 skyBlue = vec3(0.5, 0.7, 1.0);
    vec3 horizon = vec3(1.0, 0.9, 0.7);
    vec3 skyColor = mix(horizon, skyBlue, t);

    // Add animated sun
    vec3 sunDir = normalize(vec3(sin(pc.time * 0.1), 0.6, cos(pc.time * 0.1)));
    float sunDot = max(dot(direction, sunDir), 0.0);
    vec3 sunColor = vec3(1.0, 0.9, 0.7) * pow(sunDot, 256.0) * 2.0;

    return skyColor + sunColor;
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height) return;

    float aspect = float(pc.width) / float(pc.height);
    vec2 uv = (vec2(x, y) / vec2(pc.width, pc.height)) * 2.0 - 1.0;
    uv.x *= aspect;

    // Use camera data from push constants (controlled by keyboard)
    vec3 cameraPos = pc.cameraPos;
    vec3 target = pc.cameraTarget;
    vec3 up = pc.cameraUp;

    // Camera basis vectors
    vec3 forward = normalize(target - cameraPos);
    vec3 right = normalize(cross(forward, up));
    vec3 cameraUp = cross(right, forward);

    // Ray direction
    vec3 rayDir = normalize(uv.x * right - uv.y * cameraUp + 1.5 * forward);

    Ray ray = Ray(cameraPos, rayDir);

    // Primary ray
    HitInfo hit = intersectScene(ray);
    vec3 color;

    if (hit.hit) {
        vec3 viewDir = normalize(cameraPos - hit.point);
        color = calculateLighting(hit, viewDir);

        // Handle glass materials with refraction and reflection
        if (hit.material.transparency > 0.1) {
            // Glass material
            float n1 = 1.0; // Air
            float n2 = hit.material.refractionIndex;
            float fresnelFactor = fresnel(viewDir, hit.normal, n1, n2);

            // Reflection
            vec3 reflectDir = reflect(-viewDir, hit.normal);
            Ray reflectRay = Ray(hit.point + hit.normal * 0.001, reflectDir);
            HitInfo reflectHit = intersectScene(reflectRay);

            vec3 reflectColor;
            if (reflectHit.hit) {
                vec3 reflectViewDir = normalize(hit.point - reflectHit.point);
                reflectColor = calculateLighting(reflectHit, reflectViewDir);
            } else {
                reflectColor = getSkyColor(reflectDir);
            }

            // Refraction
            vec3 refractDir = refract(-viewDir, hit.normal, n1 / n2);
            vec3 refractColor = vec3(0.0);

            if (length(refractDir) > 0.0) {
                Ray refractRay = Ray(hit.point - hit.normal * 0.001, refractDir);
                HitInfo refractHit = intersectScene(refractRay);

                if (refractHit.hit) {
                    vec3 refractViewDir = normalize(hit.point - refractHit.point);
                    refractColor = calculateLighting(refractHit, refractViewDir);
                } else {
                    refractColor = getSkyColor(refractDir);
                }

                // Apply glass tint
                refractColor *= hit.material.color;
            }

            // Combine reflection and refraction based on Fresnel
            vec3 glassColor = mix(refractColor, reflectColor, fresnelFactor);
            color = mix(color, glassColor, hit.material.transparency);

        } else if (hit.material.reflectivity > 0.1) {
            // Regular reflection for metals
            vec3 reflectDir = reflect(-viewDir, hit.normal);
            Ray reflectRay = Ray(hit.point + hit.normal * 0.001, reflectDir);
            HitInfo reflectHit = intersectScene(reflectRay);

            vec3 reflectColor;
            if (reflectHit.hit) {
                vec3 reflectViewDir = normalize(hit.point - reflectHit.point);
                reflectColor = calculateLighting(reflectHit, reflectViewDir);
            } else {
                reflectColor = getSkyColor(reflectDir);
            }

            color = mix(color, reflectColor, hit.material.reflectivity * 0.6);
        }
    } else {
        color = getSkyColor(rayDir);
    }

    // Tone mapping and gamma correction
    color = color / (color + vec3(1.0));
    color = pow(color, vec3(1.0/2.2));

    // Convert to RGBA8 uint
    uvec4 rgba = uvec4(clamp(color * 255.0, 0.0, 255.0), 255.0);
    pixels[y * pc.width + x] = (rgba.r & 0xFF) |
                               ((rgba.g & 0xFF) << 8) |
                               ((rgba.b & 0xFF) << 16) |
                               ((rgba.a & 0xFF) << 24);
}
